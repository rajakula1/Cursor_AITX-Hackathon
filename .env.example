# Required — OpenRouter only (no Anthropic SDK / ANTHROPIC_API_KEY)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Supabase (optional for Block 1; in-memory fallback used if unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=http://localhost:8501
OPENROUTER_APP_TITLE=PA-Intake-Hackathon
