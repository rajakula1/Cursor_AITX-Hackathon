# Required — OpenRouter only (no Anthropic SDK / ANTHROPIC_API_KEY)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM mode: 1 = offline mocks (safer default); 0 = live OpenRouter
USE_MOCK_EXTRACT=0

# Demo talk-track #2 only — inject Fixture C's fake c3 quote (default off)
INJECT_FIXTURE_C_HALLUCINATION=0

# Optional model overrides
# OPENROUTER_EXTRACT_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_CRITIC_MODEL=anthropic/claude-sonnet-4.5
# LLM_TIMEOUT_S=60

# Supabase (optional; in-memory fallback if unset / placeholder)
# Dashboard → Project Settings → API Keys → secret / service_role
# Then run sql/setup.sql once in the SQL editor, then: python scripts/ping_supabase.py --seed
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Latency knobs
# USE_DRAFT_META_LLM=1   # optional Sonnet call for qty/duration (default off)
# LATENCY_LOG=1          # print per-node timings while debugging
# LLM_MAX_RETRIES=0      # provider retries (app already retries once)

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=http://localhost:8501
OPENROUTER_APP_TITLE=FieldCheck-Prior-Authorization
