# Required — OpenRouter only (no Anthropic SDK / ANTHROPIC_API_KEY)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM mode: 1 = offline mocks (safer default); 0 = live OpenRouter
USE_MOCK_EXTRACT=0

# Demo talk-track #2 only — inject Fixture C's fake c3 quote (default off)
INJECT_FIXTURE_C_HALLUCINATION=0

# Optional model overrides
# OPENROUTER_EXTRACT_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_CRITIC_MODEL=anthropic/claude-sonnet-4.5
# LLM_TIMEOUT_S=60

# Supabase (optional; in-memory fallback if unset / placeholder)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=http://localhost:8501
OPENROUTER_APP_TITLE=PA-Intake-Hackathon
